#include <iostream>
#include <vector>
#include <algorithm>

// Function to solve the 0-1 Knapsack problem
int zeroOneKnapsack(int W, const std::vector<int>& weights, const std::vector<int>& values, int n) {
    // DP array to store the maximum profit for each weight capacity
    std::vector<int> dp(W + 1, 0);

    // Build the table in a bottom-up manner
    for (int i = 0; i < n; ++i) {
        // Traverse capacity from right to left to avoid using the same item multiple times
        for (int w = W; w >= weights[i]; --w) {
            dp[w] = std::max(dp[w], values[i] + dp[w - weights[i]]);
        }
    }
    return dp[W];
}

int main() {
    std::vector<int> values = {60, 100, 120};
    std::vector<int> weights = {10, 20, 30};
    int W = 50; // Knapsack capacity
    int n = values.size();

    std::cout << "Maximum value in 0-1 Knapsack = " 
              << zeroOneKnapsack(W, weights, values, n) << std::endl;

    return 0;
}
